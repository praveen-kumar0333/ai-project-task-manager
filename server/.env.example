PORT=5000
HOST=0.0.0.0
NODE_ENV=production

# Frontend Origin URL for CORS (support comma-separated for multiple origins)
FRONTEND_URL=https://your-frontend-domain.example

# MySQL Database Configuration (Aiven / Managed MySQL / Self-hosted)
DB_HOST=your-aiven-service-name.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=replace_with_your_mysql_password
DB_NAME=defaultdb

# SSL/TLS Configuration (Required for Aiven MySQL)
# Aiven MySQL requires SSL: set DB_SSL=required (or auto-detected when DB_HOST contains aivencloud.com)
DB_SSL=required
DB_SSL_REJECT_UNAUTHORIZED=false
# Optional custom CA certificate string or path if strict CA validation is required:
# DB_SSL_CA=

# JWT Authentication
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Google Gemini AI API Key (Backend-only)
GEMINI_API_KEY=replace_with_your_google_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash

# Murf Text-to-Speech API Key (Optional, backend-only)
MURF_API_KEY=replace_with_your_murf_api_key

