# Frontend API Base URL (Safe for client-side exposure)
# Development/Reverse Proxy fallback: /api
# Production with dedicated backend URL: https://your-backend-api-domain.example/api
VITE_API_URL=/api

# Application Host URL (Injected at runtime by hosting platform)
APP_URL="https://your-app-domain.example"

# Server-Side API Secrets (Backend-only; never expose to frontend code)
GEMINI_API_KEY=replace_with_your_google_gemini_api_key
MURF_API_KEY=replace_with_your_murf_api_key

